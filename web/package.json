{
  "name": "url-shortener-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "npm run api:generate",
    "build": "next build",
    "prebuild": "npm run api:generate",
    "start": "next start",
    "lint": "eslint .",
    "api:generate": "openapi-typescript ../openapi.yaml -o src/generated/openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^16.1.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "jsdom": "^27.1.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.0.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
